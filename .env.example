# App origin (Vercel sets this automatically via BETTER_AUTH_URL if you configure it)
# BETTER_AUTH_URL=https://your-app.vercel.app
# BETTER_AUTH_SECRET=generate-a-long-random-string

# Optional: Postgres (Neon). Without this, the app uses embedded PGLite.
# DATABASE_URL=postgres://user:pass@host/db

# Optional: Grok auth broker (Google / X sign-in). Without these, sign-in
# buttons still render but OAuth only works when the platform injects them.
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# Set to "false" to disable sign-in UI and use a local dev user.
# VITE_AUTH_ENABLED=true
